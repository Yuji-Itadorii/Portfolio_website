---
import Chip from "~/components/ui/Chip.astro";
import { formatDateRange, toDateTimeAttr } from "~/lib/format";
import type { ExperienceRole } from "~/content";

interface Props {
  role: ExperienceRole;
  current?: boolean;
  /** Passed explicitly rather than using :last-child — each item is wrapped in
   *  a Reveal element, so every article is its parent's only child and
   *  :last-child would match all of them. */
  last?: boolean;
}

const { role, current = false, last = false } = Astro.props;
---

<article class:list={["role", current && "role--current", last && "role--last"]}>
  <div class="role__marker" aria-hidden="true"></div>

  <header class="role__head">
    {
      /* Explicit &nbsp;-free spacing: JSX strips whitespace between expressions
        and elements, which would render "Software EngineeratPaytm". */
    }
    <h3 class="role__title">
      <span>{role.title}</span>{" "}
      <span class="role__at">at</span>{" "}
      {
        role.companyUrl ? (
          <a href={role.companyUrl} target="_blank" rel="noopener noreferrer">
            {role.company}
          </a>
        ) : (
          <span>{role.company}</span>
        )
      }
    </h3>

    <p class="role__meta">
      <time datetime={toDateTimeAttr(role.start)}>{formatDateRange(role.start, role.end)}</time>
      <span aria-hidden="true">·</span>
      <span>{role.location}</span>
    </p>
  </header>

  <p class="role__summary">{role.summary}</p>

  <ul class="role__highlights">
    {
      role.highlights.map((highlight) => (
        <li class:list={["highlight", highlight.metric && "highlight--metric"]}>
          {highlight.metric && (
            <p class="highlight__metric">
              <span class="highlight__value u-mono-figure">{highlight.metric.value}</span>
              <span class="highlight__label">{highlight.metric.label}</span>
            </p>
          )}
          <p class="highlight__text">{highlight.text}</p>
        </li>
      ))
    }
  </ul>

  <ul class="role__stack">
    {
      role.stack.map((tech) => (
        <li>
          <Chip label={tech} size="sm" />
        </li>
      ))
    }
  </ul>
</article>

<style>
  .role {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 3rem;
  }

  /* The timeline rail. */
  .role::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0;
    left: 0.3125rem;
    width: 1px;
    background: var(--border);
  }

  .role--last::before {
    bottom: 2rem;
    background: linear-gradient(to bottom, var(--border), transparent);
  }

  .role--last {
    padding-bottom: 0;
  }

  .role__marker {
    position: absolute;
    top: 0.5rem;
    left: 0;
    width: 0.6875rem;
    height: 0.6875rem;
    border: 2px solid var(--surface-0);
    border-radius: var(--radius-full);
    background: var(--border-strong);
  }

  .role--current .role__marker {
    background: var(--accent-graphic);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent-graphic) 22%, transparent);
  }

  .role__title {
    font-size: var(--text-lg);
  }

  .role__at {
    color: var(--text-3);
    font-weight: 400;
  }

  /* The company link sits inside a heading full of non-link text. Colour alone
     doesn't meet the 3:1 contrast-against-surrounding-text rule, so it needs a
     shape affordance too. */
  .role__title a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }

  .role__title a:hover {
    text-decoration-color: currentColor;
  }

  .role__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.375rem;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .role__summary {
    max-width: var(--width-prose);
    margin-top: 0.875rem;
    color: var(--text-2);
  }

  .role__highlights {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.5rem;
  }

  .highlight {
    display: grid;
    gap: 0.25rem 1rem;
    max-width: 46rem;
  }

  /* Metric bullets get a two-column layout so the figures form a scannable
     left edge; text-only bullets fall back to a single column. */
  @media (min-width: 40rem) {
    .highlight--metric {
      grid-template-columns: 8.5rem 1fr;
      align-items: baseline;
    }
  }

  .highlight__metric {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .highlight__value {
    color: var(--accent);
    font-size: var(--text-xl);
  }

  .highlight__label {
    color: var(--text-3);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .highlight__text {
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .highlight:not(.highlight--metric) .highlight__text::before {
    content: "";
    display: inline-block;
    width: 0.3125rem;
    height: 0.3125rem;
    margin-right: 0.625rem;
    margin-bottom: 0.15em;
    border-radius: var(--radius-full);
    background: var(--border-strong);
    vertical-align: middle;
  }

  .role__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1.5rem;
  }
</style>
