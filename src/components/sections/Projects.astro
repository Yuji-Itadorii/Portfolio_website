---
import Section from "~/components/ui/Section.astro";
import Reveal from "~/components/ui/Reveal.astro";
import ProjectCard from "./ProjectCard.astro";
import Button from "~/components/ui/Button.astro";
import { featuredProjects, otherProjects } from "~/content";
---

<Section
  id="projects"
  eyebrow="Selected work"
  title="Things I've built"
  lede="Side projects, mostly at the intersection of retrieval, agents, and backend plumbing."
>
  <div class="featured">
    {
      featuredProjects.map((project, index) => (
        <Reveal index={index}>
          <ProjectCard project={project} />
        </Reveal>
      ))
    }
  </div>

  {
    otherProjects.length > 0 && (
      <>
        <h3 class="more__heading">Also worth a look</h3>
        <div class="more">
          {otherProjects.map((project, index) => (
            <Reveal index={index}>
              <ProjectCard project={project} compact />
            </Reveal>
          ))}
        </div>
      </>
    )
  }

  <div class="projects__cta">
    <Button
      href="https://github.com/Yuji-Itadorii"
      variant="outline"
      iconEnd="lucide:arrow-up-right"
      external
    >
      All repositories on GitHub
    </Button>
  </div>
</Section>

<style>
  .featured,
  .more {
    display: grid;
    gap: 1.25rem;
  }

  .featured {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .more {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  /* Reveal wraps each card in a div, so the grid item must stretch or short
     cards won't fill their row. */
  .featured > :global(*),
  .more > :global(*) {
    display: flex;
  }

  .featured > :global(*) > :global(*),
  .more > :global(*) > :global(*) {
    flex: 1;
  }

  .more__heading {
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .projects__cta {
    margin-top: 2.5rem;
  }
</style>
