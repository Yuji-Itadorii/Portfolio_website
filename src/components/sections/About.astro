---
import Section from "~/components/ui/Section.astro";
import Reveal from "~/components/ui/Reveal.astro";
import { achievements, education, profile } from "~/content";
import { Icon } from "astro-icon/components";
---

<Section id="about" eyebrow="Background" title="About">
  <div class="about">
    <Reveal class="about__bio">
      <p class="about__lede">{profile.bio}</p>

      <h3 class="about__subhead">
        <Icon name="lucide:graduation-cap" aria-hidden="true" />
        Education
      </h3>
      <ul class="edu">
        {
          education.map((entry) => (
            <li class="edu__item">
              <p class="edu__institution">{entry.institution}</p>
              <p class="edu__qualification">{entry.qualification}</p>
              <p class="edu__meta">
                <span class="u-mono-figure">{entry.detail}</span>
                <span aria-hidden="true">·</span>
                <span>{entry.period}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </Reveal>

    <Reveal class="about__side" index={1}>
      <h3 class="about__subhead">
        <Icon name="lucide:award" aria-hidden="true" />
        Achievements
      </h3>
      <ul class="wins">
        {
          achievements.map((item) => (
            <li class="win">
              <Icon name={item.icon} class="win__glyph" aria-hidden="true" />
              <div>
                <p class="win__title">
                  {item.title}
                  {item.year && <span class="win__year u-mono-figure">{item.year}</span>}
                </p>
                {item.detail && <p class="win__detail">{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </Reveal>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }
  }

  .about__lede {
    max-width: var(--width-prose);
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .about__subhead {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1.125rem;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .about__subhead :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--accent);
  }

  .about :global(.about__side) .about__subhead {
    margin-top: 0;
  }

  .edu {
    display: grid;
    gap: 1.25rem;
  }

  .edu__item {
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }

  .edu__institution {
    color: var(--text-1);
    font-weight: 600;
  }

  .edu__qualification {
    margin-top: 0.125rem;
    color: var(--text-2);
    font-size: var(--text-sm);
  }

  .edu__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.375rem;
    color: var(--text-3);
    font-size: var(--text-xs);
  }

  .wins {
    display: grid;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }

  .win {
    display: flex;
    gap: 0.75rem;
  }

  .win__glyph {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    color: var(--accent);
  }

  .win__title {
    color: var(--text-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .win__year {
    margin-left: 0.5rem;
    color: var(--text-3);
    font-size: var(--text-2xs);
    font-weight: 500;
  }

  .win__detail {
    margin-top: 0.125rem;
    color: var(--text-3);
    font-size: var(--text-xs);
    line-height: 1.55;
  }
</style>
