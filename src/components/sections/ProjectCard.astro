---
import { Icon } from "astro-icon/components";
import Chip from "~/components/ui/Chip.astro";
import type { Project } from "~/content";

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const primaryUrl = project.liveUrl ?? project.repoUrl;
---

<article class:list={["card", compact && "card--compact"]}>
  <div class="card__head">
    <h3 class="card__title">
      {
        primaryUrl ? (
          /* Stretched link: the whole card is the hit target, but only the
             title is in the tab order — so keyboard users get one stop, not
             three overlapping ones. */
          <a class="card__link" href={primaryUrl} target="_blank" rel="noopener noreferrer">
            {project.title}
            <Icon name="lucide:arrow-up-right" class="card__arrow" aria-hidden="true" />
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <p class="card__year u-mono-figure">{project.year}</p>
  </div>

  <p class="card__kicker">{project.kicker}</p>
  <p class="card__description">{project.description}</p>

  {
    !compact && project.highlights && (
      <ul class="card__highlights">
        {project.highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  <ul class="card__stack">
    {
      project.stack.map((tech) => (
        <li>
          <Chip label={tech} size="sm" />
        </li>
      ))
    }
  </ul>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    transition:
      border-color var(--dur-base) var(--ease-out-quart),
      box-shadow var(--dur-base) var(--ease-out-quart),
      translate var(--dur-base) var(--ease-out-quart);
  }

  .card:hover {
    border-color: color-mix(in oklab, var(--accent-graphic) 45%, var(--border));
    box-shadow: var(--shadow-2);
    translate: 0 -3px;
  }

  /* Keep the focus ring on the card, not just the small inline link. */
  .card:focus-within {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .card__title {
    font-size: var(--text-lg);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--text-1);
    text-decoration: none;
  }

  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:hover .card__link {
    color: var(--accent);
  }

  .card__arrow {
    width: 0.9em;
    height: 0.9em;
    color: var(--text-3);
    transition: translate var(--dur-fast) var(--ease-out-quart);
  }

  .card:hover .card__arrow {
    color: var(--accent);
    translate: 2px -2px;
  }

  .card__year {
    flex: none;
    color: var(--text-3);
    font-size: var(--text-xs);
  }

  .card__kicker {
    margin-top: 0.375rem;
    color: var(--accent);
    font-size: var(--text-sm);
  }

  .card__description {
    margin-top: 0.75rem;
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .card__highlights {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--text-3);
    font-size: var(--text-sm);
  }

  .card__highlights li {
    display: flex;
    gap: 0.625rem;
    line-height: 1.55;
  }

  .card__highlights li::before {
    content: "";
    flex: none;
    width: 0.3125rem;
    height: 0.3125rem;
    margin-top: 0.6em;
    border-radius: var(--radius-full);
    background: var(--accent-graphic);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .card--compact .card__description {
    font-size: var(--text-xs);
  }
</style>
