---
import { seo, personSchema } from "~/content";

interface Props {
  title?: string;
  description?: string;
  /** Set on pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
}

const { title, description = seo.description, noindex = false } = Astro.props;

const pageTitle = title ? seo.titleTemplate.replace("%s", title) : seo.title;
const canonical = new URL(Astro.url.pathname, seo.siteUrl).href.replace(/\/$/, "") || seo.siteUrl;
const ogImageUrl = new URL(seo.ogImage, seo.siteUrl).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

{/* Theme-aware browser chrome. Two entries so the address bar tracks the OS. */}
<meta name="theme-color" content={seo.themeColor.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={seo.themeColor.dark} media="(prefers-color-scheme: dark)" />

{/* Open Graph */}
<meta property="og:type" content="profile" />
<meta property="og:site_name" content="Abhay Rawat" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={seo.ogImageAlt} />

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={seo.ogImageAlt} />

{/* Favicons — replaces the hotlinked third-party emoji the old site used. */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
