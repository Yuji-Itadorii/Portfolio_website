---
import { HERO_LAYERS, HERO_SIZES, isLcpLayer, srcsetFor } from "./layers";
---

{
  /*
  Decorative art. The hero's meaning lives in the adjacent <h1> and tagline, so
  the whole stage is aria-hidden and every layer has alt="" — twelve described
  tree layers would be pure screen-reader noise.

  overflow: clip rather than hidden: `hidden` establishes a scroll container,
  which confuses ScrollTimeline resolution.
*/
}
<div class="hero-stage" data-parallax aria-hidden="true">
  {
    HERO_LAYERS.map((layer, index) => (
      <div
        class="hero-layer"
        data-dx={layer.dx}
        data-dy={layer.dy}
        data-scale={layer.scale}
        data-mobile={layer.mobile}
        style={`--z:${index}; --overscan:${layer.overscan}%`}
      >
        {/*
          Every layer is above the fold, so lazy-loading them would be an
          own-goal — except the two dropped on mobile, where `lazy` inside a
          display:none ancestor means the fetch never happens at all.

          The LCP candidates (the sky pair) decode synchronously so the first
          paint includes them; the rest stay async, off the critical path.
        */}
        <picture>
          <source type="image/avif" srcset={srcsetFor(layer.id, "avif")} sizes={HERO_SIZES} />
          <source type="image/webp" srcset={srcsetFor(layer.id, "webp")} sizes={HERO_SIZES} />
          <img
            src={`/hero/${layer.id}-1920.png`}
            alt=""
            width="1920"
            height="1080"
            decoding={isLcpLayer(layer.id) ? "sync" : "async"}
            loading={layer.mobile === "drop" ? "lazy" : "eager"}
            fetchpriority={isLcpLayer(layer.id) ? "high" : "auto"}
          />
        </picture>
      </div>
    ))
  }
</div>

<style>
  .hero-stage {
    position: absolute;
    inset: 0;
    z-index: var(--z-hero-bg);
    overflow: clip;
    contain: layout paint;
    background: var(--surface-2);
  }

  .hero-layer {
    position: absolute;
    inset: 0;
    z-index: var(--z);
    transform: translate3d(0, 0, 0);
  }

  .hero-layer img {
    position: absolute;
    inset-block: 0;
    /* Bleed the image past both edges so a translating layer never exposes
       the stage background behind it. */
    left: calc(-1 * var(--overscan));
    width: calc(100% + 2 * var(--overscan));
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  @media (max-width: 48rem) {
    .hero-layer[data-mobile="drop"] {
      display: none;
    }

    /* The art is a 16:9 landscape scene. Covering a tall portrait viewport
       crops away everything but a sliver of ground, which is why the old site
       just gave up and hid it. Instead, scale each layer to the viewport width
       and anchor the resulting band to the bottom of the hero, so the whole
       scene reads. Height is left to the image so the overscan bleed doesn't
       push the artwork out of its own box. */
    .hero-layer {
      inset: auto 0 0 0;
      height: auto;
    }

    .hero-layer img {
      position: relative;
      inset: auto;
      height: auto;
      /* Motion is damped to 45% here, so a narrower bleed is enough. */
      left: calc(-0.5 * var(--overscan));
      width: calc(100% + var(--overscan));
      object-fit: contain;
    }
  }
</style>

<script>
  /**
   * Motion is ~69 KB and costs real main-thread time to parse on a mid-range
   * phone. Keeping it in the initial module graph pushed LCP render-delay to
   * 2.5s under CPU throttling, so it is dynamically imported and deferred to
   * idle instead. The hero is fully painted and readable before any of this
   * runs — the parallax is pure enhancement.
   */
  const stage = document.querySelector<HTMLElement>("[data-parallax]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  let started = false;

  const start = () => {
    if (started || !stage || reduce.matches) return;
    started = true;
    void import("./parallax").then(({ initParallax }) => initParallax(stage));
  };

  const schedule = () => {
    // Checked via typeof rather than `in window`: the `in` operator narrows
    // `window` itself to never in the else branch.
    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(start, { timeout: 2500 });
    } else {
      window.setTimeout(start, 300);
    }
  };

  if (stage && !reduce.matches) schedule();

  // If motion is re-enabled mid-session, pick it up without a reload.
  reduce.addEventListener("change", (event) => {
    if (!event.matches) schedule();
  });
</script>
