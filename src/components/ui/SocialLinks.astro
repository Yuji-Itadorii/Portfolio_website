---
import { Icon } from "astro-icon/components";
import { socials } from "~/content";

interface Props {
  /** Compact icon-only row, used in the footer. */
  iconOnly?: boolean;
  class?: string;
}

const { iconOnly = false, class: className }: Props = Astro.props;
---

<ul class:list={["socials", iconOnly && "socials--icons", className]}>
  {
    socials.map((social) => (
      <li>
        <a
          class="social"
          href={social.href}
          target={social.href.startsWith("mailto:") ? undefined : "_blank"}
          rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
          aria-label={iconOnly ? social.label : undefined}
        >
          {/* Glyph is decorative when a visible label sits beside it; when the
              label is hidden, aria-label on the anchor carries the name. The
              old site had alt="" on every social icon and no label at all. */}
          <Icon name={social.icon} class="social__glyph" aria-hidden="true" />
          {!iconOnly && (
            <span class="social__text">
              <span class="social__label">{social.label}</span>
              <span class="social__handle">{social.handle}</span>
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .socials--icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0;
  }

  .social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out-quart),
      color var(--dur-fast) var(--ease-out-quart);
  }

  .social:hover {
    background: var(--surface-2);
    color: var(--text-1);
  }

  .socials--icons .social {
    padding: 0.5rem;
  }

  .social__glyph {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--text-3);
  }

  .social:hover .social__glyph {
    color: var(--accent);
  }

  .social__text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .social__label {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .social__handle {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    overflow-wrap: anywhere;
  }
</style>
