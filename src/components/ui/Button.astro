---
import { Icon } from "astro-icon/components";

interface Props {
  href?: string;
  /** Only meaningful when rendering a <button>. Defaults to "button" so a
   *  stray button never submits an enclosing form by accident — but the
   *  contact form's submit MUST pass "submit" or the form is inert. */
  type?: "button" | "submit" | "reset";
  variant?: "solid" | "outline" | "ghost";
  icon?: string;
  iconEnd?: string;
  external?: boolean;
  download?: boolean;
  disabled?: boolean;
  title?: string;
  class?: string;
  id?: string;
}

const {
  href,
  type = "button",
  variant = "solid",
  icon,
  iconEnd,
  external = false,
  download = false,
  disabled = false,
  title,
  class: className,
  id,
} = Astro.props;

const Tag = href && !disabled ? "a" : "button";

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<Tag
  id={id}
  class:list={["btn", `btn--${variant}`, className]}
  href={disabled ? undefined : href}
  rel={rel}
  target={target}
  download={download ? "" : undefined}
  title={title}
  aria-disabled={disabled ? "true" : undefined}
  disabled={Tag === "button" && disabled ? true : undefined}
  type={Tag === "button" ? type : undefined}
>
  {icon && <Icon name={icon} class="btn__icon" aria-hidden="true" />}
  <span><slot /></span>
  {iconEnd && <Icon name={iconEnd} class="btn__icon" aria-hidden="true" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6875rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-quart),
      border-color var(--dur-fast) var(--ease-out-quart),
      color var(--dur-fast) var(--ease-out-quart),
      translate var(--dur-fast) var(--ease-out-quart);
  }

  .btn:hover:not([aria-disabled="true"]) {
    translate: 0 -1px;
  }

  .btn[aria-disabled="true"],
  .btn:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .btn__icon {
    width: 1.05em;
    height: 1.05em;
    flex: none;
  }

  .btn--solid {
    background: var(--accent-solid);
    color: var(--accent-on);
  }
  .btn--solid:hover:not([aria-disabled="true"]) {
    background: var(--accent-hover);
    color: var(--accent-on);
  }

  .btn--outline {
    border-color: var(--border-strong);
    background: var(--surface-1);
    color: var(--text-1);
  }
  .btn--outline:hover:not([aria-disabled="true"]) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn--ghost {
    background: transparent;
    color: var(--text-2);
  }
  .btn--ghost:hover:not([aria-disabled="true"]) {
    background: var(--surface-2);
    color: var(--text-1);
  }
</style>
