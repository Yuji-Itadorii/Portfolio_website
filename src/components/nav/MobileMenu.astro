---
import { Icon } from "astro-icon/components";
import { profile, sections, socials } from "~/content";
import { RESUME_PATH, resumeExists } from "~/lib/resume";
---

{
  /*
  Native <dialog> + showModal(). That gives focus trapping, Esc-to-close, an
  inert background and correct ARIA semantics for free — roughly 200 lines of
  hand-rolled modal code that don't need to exist or be maintained.
*/
}
<dialog class="menu" data-mobile-menu aria-label="Site menu">
  <div class="menu__head">
    <span class="menu__title">{profile.name}</span>
    <button class="menu__close" type="button" data-close-menu aria-label="Close menu">
      <Icon name="lucide:x" aria-hidden="true" />
    </button>
  </div>

  <nav aria-label="Mobile">
    <ul class="menu__list">
      {
        sections.map((section) => (
          <li>
            <a class="menu__link" href={`#${section.id}`} data-nav-link={section.id}>
              {section.label}
              <Icon name="lucide:chevron-right" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu__foot">
    {
      resumeExists && (
        <a class="menu__resume" href={RESUME_PATH} download>
          <Icon name="lucide:download" aria-hidden="true" />
          Download resume
        </a>
      )
    }
    <ul class="menu__socials">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.href}
              aria-label={social.label}
              target={social.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={social.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <Icon name={social.icon} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<style>
  .menu {
    width: min(22rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 1.25rem;
    border: none;
    border-left: 1px solid var(--border);
    background: var(--surface-0);
    color: var(--text-2);
  }

  .menu::backdrop {
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] {
      animation: slide-in var(--dur-base) var(--ease-out-expo);
    }

    @keyframes slide-in {
      from {
        translate: 100% 0;
      }
    }
  }

  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .menu__title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-1);
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface-1);
    color: var(--text-2);
    cursor: pointer;
  }

  .menu__close :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .menu__list {
    display: grid;
    gap: 0.125rem;
    padding-block: 1rem;
  }

  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.625rem;
    border-radius: var(--radius-sm);
    color: var(--text-1);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    text-decoration: none;
  }

  .menu__link :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--text-3);
  }

  .menu__link[aria-current="true"] {
    background: var(--accent-wash);
    color: var(--accent);
  }

  .menu__foot {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .menu__resume {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .menu__resume :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .menu__socials {
    display: flex;
    gap: 0.5rem;
  }

  .menu__socials a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text-3);
  }

  .menu__socials :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-mobile-menu]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-open-menu]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-close-menu]");

  openButton?.addEventListener("click", () => dialog?.showModal());
  closeButton?.addEventListener("click", () => dialog?.close());

  // Anchor navigation inside a modal dialog does nothing until it closes.
  dialog?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("a[href^='#']")) dialog.close();
    // Click on the backdrop (the dialog element itself, not its children).
    if (target === dialog) dialog.close();
  });
</script>
