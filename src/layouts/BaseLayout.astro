---
import Seo from "~/components/seo/Seo.astro";
import "~/styles/global.css";

// Resolved through Vite so the preload href matches the hashed emitted asset.
// Hardcoding /_astro/... paths here would silently 404 after every build.
import soraLatin from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    {
      /*
      No-flash theme resolution. This MUST run before any stylesheet, and
      `is:inline` keeps Astro from hoisting it into the bundle.

      The try/catch is not decorative: localStorage throws in Safari private
      mode and inside some in-app browsers, and an uncaught throw here would
      leave the page completely unstyled.
    */
    }
    <script is:inline>
      (() => {
        const KEY = "ar-theme";
        let t;
        try {
          t = localStorage.getItem(KEY);
        } catch {
          /* storage unavailable — fall through to the OS preference */
        }
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>

    <Seo title={title} description={description} noindex={noindex} />

    {
      /* Only the two above-the-fold families are preloaded. JetBrains Mono
        loads normally — it first appears below the fold. */
    }
    <link rel="preload" as="font" type="font/woff2" href={soraLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    {/* Pages inject their own LCP preloads here. */}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    {
      /* Gate colour transitions until after first paint, so the initial render
        doesn't visibly animate into place. */
    }
    <script is:inline>
      requestAnimationFrame(() => {
        document.documentElement.setAttribute("data-theme-ready", "");
      });
    </script>
  </body>
</html>
