{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.mjs", "**/*.astro"],
  "exclude": ["dist", "node_modules", "playwright-report", ".lighthouseci"],
  "compilerOptions": {
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "~/*": ["./src/*"]
    }
  }
}
